    {
      "parameters": {
        "jsCode": "const aiResponse = $input.first().json;\nconst rawText = aiResponse.choices[0].message.content;\n\nlet parsed;\ntry {\n  parsed = JSON.parse(rawText);\n} catch (e) {\n  const match = rawText.match(/\\{[\\s\\S]*\\}/);\n  if (!match) throw new Error('Groq response has no JSON: ' + rawText);\n  parsed = JSON.parse(match[0]);\n}\n\n// Get original customer data from the Google Sheets node\nconst customer = $('Get row(s) in sheet').first().json;\n\nreturn [{\n  json: {\n    customer_id: customer.CustomerID,\n    customer_name: customer.CustomerName,\n    email: customer.Email,\n    plan: customer.Plan,\n    mrr: customer.MRR,\n    risk_level: parsed.risk_level || 'LOW',\n    churn_probability: parsed.churn_probability || '0',\n    risk_factors: parsed.top_risk_factors || 'None identified',\n    recommended_action: parsed.recommended_action || 'Monitor',\n    email_subject: parsed.win_back_email_subject || 'Checking in on your account',\n    email_body: parsed.win_back_email_body || '',\n    analysed_at: new Date().toISOString()\n  }\n}];"
      },
