        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"temperature\": 0.2,\n  \"max_tokens\": 700,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a customer success expert specialising in churn prediction. Analyse the customer data and predict their churn risk. Be specific about WHY they are at risk based on their actual numbers. Return ONLY valid JSON, no text outside it:\\n{\\n  \\\"risk_level\\\": \\\"HIGH or MEDIUM or LOW\\\",\\n  \\\"churn_probability\\\": \\\"percentage as number 0-100\\\",\\n  \\\"top_risk_factors\\\": \\\"2-3 specific reasons based on their data\\\",\\n  \\\"recommended_action\\\": \\\"specific action the CS team should take\\\",\\n  \\\"win_back_email_subject\\\": \\\"personalised email subject line\\\",\\n  \\\"win_back_email_body\\\": \\\"personalised re-engagement email under 120 words, warm and helpful tone, reference their specific usage pattern, signed from Customer Success Team\\\"\\n}\\n\\nRisk scoring guide:\\nHIGH: logins < 5 last 30 days, or support tickets > 3, or payment failed, or last login > 30 days ago\\nMEDIUM: logins 5-15, or 1-3 tickets, or usage declining\\nLOW: active, engaged, healthy payments\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Analyse churn risk for this customer:\\nName: {{$json.CustomerName}}\\nPlan: {{$json.Plan}}\\nMRR: ${{$json.MRR}}\\nSignup Date: {{$json.SignupDate}}\\nLast Login: {{$json.LastLoginDate}}\\nLogins last 30 days: {{$json.LoginCount30Days}}\\nSupport tickets (last 90 days): {{$json.SupportTickets}}\\nFeature usage level: {{$json.FeatureUsage}}\\nFailed payment: {{$json.PaymentFailed}}\"\n    }\n  ]\n}",
        "options": {}
      },
